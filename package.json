{
  "name": "dotgas",
  "private": true,
  "description": "DotGas: gas onboarding into Portaldot (Base Sepolia -> Portaldot tPOT)",
  "license": "MIT",
  "workspaces": [
    "relayer",
    "web",
    "scripts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "make test",
