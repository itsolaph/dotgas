{
  "name": "@landfall/relayer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Landfall relayer: watches LandfallGate on Base, approves on ink! rules, fills LandfallDock on Portaldot, claims on Base",
  "bin": {
    "landfall-relayer": "src/index.ts"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/index.ts",
    "dry-run": "node --env-file-if-exists=../.env src/index.ts --dry-run",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@polkadot/api": "^17.0.2",
    "@polkadot/api-contract": "^17.0.2",
    "@polkadot/keyring": "^14.0.1",
    "@polkadot/util": "^14.0.1",
    "@polkadot/util-crypto": "^14.0.1",
    "viem": "^2.57.8"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.9.3"
  }
}
